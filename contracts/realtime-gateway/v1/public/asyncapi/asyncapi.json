{
  "asyncapi": "3.0.0",
  "channels": {
    "realtime": {
      "address": "/realtime/development/v1",
      "messages": {
        "binary": {
          "$ref": "#/components/messages/BinaryFrame"
        },
        "clientControl": {
          "$ref": "#/components/messages/ClientControl"
        },
        "serverControl": {
          "$ref": "#/components/messages/ServerControl"
        }
      }
    }
  },
  "components": {
    "messages": {
      "BinaryFrame": {
        "contentType": "application/octet-stream",
        "name": "BinaryFrame",
        "payload": {
          "description": "Bytes 0..5 are version, type, and big-endian connectorChannelId; remaining bytes are raw Yjs or awareness payload.",
          "format": "binary",
          "type": "string"
        }
      },
      "ClientControl": {
        "contentType": "application/json",
        "name": "ClientControl",
        "payload": {
          "oneOf": [
            {
              "properties": {
                "channelId": {
                  "format": "uuid",
                  "type": "string"
                },
                "channelTicket": {
                  "type": "string"
                },
                "channelType": {
                  "const": "BlockPack",
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "subscribe",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "channelType",
                "channelId",
                "channelTicket"
              ],
              "type": "object"
            },
            {
              "properties": {
                "connectorChannelId": {
                  "minimum": 1,
                  "type": "integer"
                },
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "unsubscribe",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "connectorChannelId"
              ],
              "type": "object"
            },
            {
              "properties": {
                "connectorChannelId": {
                  "minimum": 1,
                  "type": "integer"
                },
                "requestId": {
                  "type": "string"
                },
                "sequence": {
                  "format": "int64",
                  "type": "integer"
                },
                "type": {
                  "const": "ack",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "connectorChannelId",
                "sequence"
              ],
              "type": "object"
            },
            {
              "properties": {
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "ping",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type"
              ],
              "type": "object"
            },
            {
              "properties": {
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "heartbeat",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type"
              ],
              "type": "object"
            }
          ]
        }
      },
      "ServerControl": {
        "contentType": "application/json",
        "name": "ServerControl",
        "payload": {
          "oneOf": [
            {
              "properties": {
                "connectionId": {
                  "format": "uuid",
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                },
                "resubscribeRequired": {
                  "type": "boolean"
                },
                "type": {
                  "const": "ready",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "connectionId",
                "resubscribeRequired"
              ],
              "type": "object"
            },
            {
              "properties": {
                "channelId": {
                  "format": "uuid",
                  "type": "string"
                },
                "channelType": {
                  "const": "BlockPack",
                  "type": "string"
                },
                "connectorChannelId": {
                  "minimum": 1,
                  "type": "integer"
                },
                "documentQuotaPolicyVersion": {
                  "const": 1,
                  "type": "integer"
                },
                "existing": {
                  "type": "boolean"
                },
                "maximumBlockCount": {
                  "minimum": 1,
                  "type": "integer"
                },
                "participants": {
                  "items": {
                    "properties": {
                      "channelPermission": {
                        "enum": [
                          "read",
                          "write"
                        ],
                        "type": "string"
                      },
                      "connectionCount": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "userPublicId": {
                        "format": "uuid",
                        "type": "string"
                      }
                    },
                    "required": [
                      "userPublicId",
                      "channelPermission",
                      "connectionCount"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "subscribed",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "channelType",
                "channelId",
                "connectorChannelId",
                "existing",
                "documentQuotaPolicyVersion",
                "maximumBlockCount"
              ],
              "type": "object"
            },
            {
              "properties": {
                "channelId": {
                  "format": "uuid",
                  "type": "string"
                },
                "channelType": {
                  "const": "BlockPack",
                  "type": "string"
                },
                "connectorChannelId": {
                  "minimum": 1,
                  "type": "integer"
                },
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "unsubscribed",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "channelType",
                "channelId",
                "connectorChannelId"
              ],
              "type": "object"
            },
            {
              "properties": {
                "connectorChannelId": {
                  "minimum": 1,
                  "type": "integer"
                },
                "requestId": {
                  "type": "string"
                },
                "sequence": {
                  "format": "int64",
                  "type": "integer"
                },
                "type": {
                  "const": "acknowledged",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "connectorChannelId",
                "sequence"
              ],
              "type": "object"
            },
            {
              "properties": {
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "pong",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type"
              ],
              "type": "object"
            },
            {
              "properties": {
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "heartbeat",
                  "type": "string"
                },
                "unixMilliNow": {
                  "format": "int64",
                  "type": "integer"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "unixMilliNow"
              ],
              "type": "object"
            },
            {
              "properties": {
                "channelId": {
                  "format": "uuid",
                  "type": "string"
                },
                "channelType": {
                  "const": "BlockPack",
                  "type": "string"
                },
                "participant": {
                  "properties": {
                    "channelPermission": {
                      "enum": [
                        "read",
                        "write"
                      ],
                      "type": "string"
                    },
                    "connectionCount": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "userPublicId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "userPublicId",
                    "channelPermission",
                    "connectionCount"
                  ],
                  "type": "object"
                },
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "presence-joined",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "channelType",
                "channelId",
                "participant"
              ],
              "type": "object"
            },
            {
              "properties": {
                "channelId": {
                  "format": "uuid",
                  "type": "string"
                },
                "channelType": {
                  "const": "BlockPack",
                  "type": "string"
                },
                "participant": {
                  "properties": {
                    "channelPermission": {
                      "enum": [
                        "read",
                        "write"
                      ],
                      "type": "string"
                    },
                    "connectionCount": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "userPublicId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "userPublicId",
                    "channelPermission",
                    "connectionCount"
                  ],
                  "type": "object"
                },
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "presence-left",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "channelType",
                "channelId",
                "participant"
              ],
              "type": "object"
            },
            {
              "properties": {
                "channelId": {
                  "format": "uuid",
                  "type": "string"
                },
                "channelType": {
                  "const": "BlockPack",
                  "type": "string"
                },
                "participant": {
                  "properties": {
                    "channelPermission": {
                      "enum": [
                        "read",
                        "write"
                      ],
                      "type": "string"
                    },
                    "connectionCount": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "userPublicId": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "userPublicId",
                    "channelPermission",
                    "connectionCount"
                  ],
                  "type": "object"
                },
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "presence-updated",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "channelType",
                "channelId",
                "participant"
              ],
              "type": "object"
            },
            {
              "properties": {
                "change": {
                  "type": "string"
                },
                "eventId": {
                  "format": "uuid",
                  "type": "string"
                },
                "eventType": {
                  "type": "string"
                },
                "permission": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                },
                "resourceId": {
                  "format": "uuid",
                  "type": "string"
                },
                "targetUserPublicId": {
                  "format": "uuid",
                  "type": "string"
                },
                "type": {
                  "const": "resource-event",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "eventId",
                "eventType",
                "resourceId",
                "change"
              ],
              "type": "object"
            },
            {
              "properties": {
                "createdAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "eventId": {
                  "format": "uuid",
                  "type": "string"
                },
                "expiresAt": {
                  "format": "date-time",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "notificationId": {
                  "format": "uuid",
                  "type": "string"
                },
                "notificationType": {
                  "type": "string"
                },
                "payload": {},
                "priority": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                },
                "templateKey": {
                  "type": "string"
                },
                "templateVersion": {
                  "type": "integer"
                },
                "type": {
                  "const": "notification",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "eventId",
                "notificationId",
                "notificationType",
                "priority",
                "templateKey",
                "templateVersion",
                "payload",
                "createdAt"
              ],
              "type": "object"
            },
            {
              "properties": {
                "attempt": {
                  "minimum": 1,
                  "type": "integer"
                },
                "eventId": {
                  "format": "uuid",
                  "type": "string"
                },
                "occurredAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                },
                "routineId": {
                  "format": "uuid",
                  "type": "string"
                },
                "routineTaskId": {
                  "format": "uuid",
                  "type": "string"
                },
                "routineTaskRecordId": {
                  "format": "uuid",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "running",
                    "completed"
                  ],
                  "type": "string"
                },
                "type": {
                  "const": "routine-task-lifecycle",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "eventId",
                "routineTaskId",
                "routineTaskRecordId",
                "routineId",
                "purpose",
                "status",
                "attempt",
                "occurredAt"
              ],
              "type": "object"
            },
            {
              "properties": {
                "channelId": {
                  "format": "uuid",
                  "type": "string"
                },
                "channelType": {
                  "const": "BlockPack",
                  "type": "string"
                },
                "code": {
                  "enum": [
                    "authentication_managed_by_upgrade",
                    "binary_channel_not_ready",
                    "block_pack_quota_exceeded",
                    "channel_backpressure",
                    "channel_limit_exceeded",
                    "channel_not_found",
                    "channel_permission_denied",
                    "invalid_acknowledgement",
                    "invalid_binary_frame",
                    "invalid_channel_id",
                    "invalid_channel_ticket",
                    "invalid_channel_type",
                    "invalid_connector_channel_id",
                    "invalid_control_frame",
                    "permission_revoked",
                    "resource_unavailable",
                    "room_admission_unavailable",
                    "room_connection_limit_exceeded",
                    "resubscribe_required",
                    "ticket_already_used",
                    "unsupported_binary_type",
                    "unsupported_channel_type",
                    "unsupported_control_type",
                    "unsupported_message_type",
                    "unsupported_protocol_version",
                    "worker_unavailable"
                  ],
                  "type": "string"
                },
                "connectorChannelId": {
                  "minimum": 1,
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                },
                "type": {
                  "const": "error",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "type",
                "code",
                "message"
              ],
              "type": "object"
            }
          ]
        }
      }
    },
    "securitySchemes": {
      "connectionTicket": {
        "description": "Single-use connection ticket issued by Gateway v1.",
        "in": "header",
        "name": "Sec-WebSocket-Protocol",
        "type": "httpApiKey"
      }
    }
  },
  "info": {
    "description": "Public multiplexed RealtimeGateway protocol. Text frames are JSON; binary frames use the documented six-byte header.",
    "title": "Notegic RealtimeGateway WebSocket API",
    "version": "1.0.0"
  },
  "operations": {
    "receiveServerControl": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/realtime"
      },
      "messages": [
        {
          "$ref": "#/channels/realtime/messages/serverControl"
        },
        {
          "$ref": "#/channels/realtime/messages/binary"
        }
      ]
    },
    "sendClientControl": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/realtime"
      },
      "messages": [
        {
          "$ref": "#/channels/realtime/messages/clientControl"
        },
        {
          "$ref": "#/channels/realtime/messages/binary"
        }
      ]
    }
  },
  "servers": {
    "hostedBeta": {
      "description": "Hosted Beta",
      "host": "api.notegic.app",
      "pathname": "/realtime/development/v1",
      "protocol": "wss",
      "security": [
        {
          "$ref": "#/components/securitySchemes/connectionTicket"
        }
      ]
    },
    "local": {
      "description": "Local development",
      "host": "localhost",
      "pathname": "/realtime/development/v1",
      "protocol": "ws",
      "security": [
        {
          "$ref": "#/components/securitySchemes/connectionTicket"
        }
      ]
    }
  }
}
