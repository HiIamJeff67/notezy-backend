{
  "components": {
    "schemas": {
      "Exception": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "Participant": {
        "properties": {
          "channelPermission": {
            "enum": [
              "read",
              "write"
            ],
            "type": "string"
          },
          "connectionCount": {
            "minimum": 1,
            "type": "integer"
          },
          "userPublicId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "userPublicId",
          "channelPermission",
          "connectionCount"
        ],
        "type": "object"
      },
      "ParticipantsResponse": {
        "properties": {
          "data": {
            "properties": {
              "participants": {
                "items": {
                  "$ref": "#/components/schemas/Participant"
                },
                "type": "array"
              }
            },
            "required": [
              "participants"
            ],
            "type": "object"
          },
          "exception": {
            "$ref": "#/components/schemas/Exception"
          },
          "metadata": {
            "properties": {
              "requestId": {
                "type": "string"
              },
              "respondedAt": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "requestId",
              "respondedAt"
            ],
            "type": "object"
          },
          "version": {
            "const": "v1",
            "type": "string"
          }
        },
        "required": [
          "version",
          "metadata",
          "data"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "accessCookie": {
        "in": "cookie",
        "name": "accessToken",
        "type": "apiKey"
      },
      "refreshCookie": {
        "in": "cookie",
        "name": "refreshToken",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Versioned HTTP surface emitted directly by RealtimeGateway. The WebSocket protocol is defined by asyncapi/asyncapi.json.",
    "title": "Notezy RealtimeGateway HTTP API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/block-pack/{block-pack-id}/participants": {
      "get": {
        "operationId": "getRealtimeBlockPackParticipants",
        "parameters": [
          {
            "in": "path",
            "name": "block-pack-id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParticipantsResponse"
                }
              }
            },
            "description": "Presence snapshot"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication failed"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Presence unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          },
          {
            "refreshCookie": []
          }
        ],
        "summary": "Get active BlockPack participants",
        "tags": [
          "Presence"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost/realtime/development/v1"
    },
    {
      "url": "https://api.notezy.app/realtime/development/v1"
    }
  ]
}
