{
  "info": {
    "_postman_id": "b6353bbc-7456-49f5-b94d-a6948906cb98",
    "description": "RealtimeGateway HTTP presence request. Use the included browser WebSocket example for the multiplex protocol.",
    "name": "Notezy RealtimeGateway v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Presence response is successful', function () { pm.response.to.have.status(200); });",
              "pm.test('Participants is an array', function () { pm.expect(pm.response.json().data.participants).to.be.an('array'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "name": "Get active BlockPack participants",
      "request": {
        "header": [
          {
            "key": "User-Agent",
            "value": "{{userAgent}}"
          },
          {
            "key": "X-Request-Id",
            "value": "postman-presence-1"
          }
        ],
        "method": "GET",
        "url": {
          "host": [
            "{{realtimeBaseUrl}}"
          ],
          "raw": "{{realtimeBaseUrl}}/block-pack/{{blockPackId}}/participants"
        }
      }
    }
  ]
}
